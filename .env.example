# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_resume_analyzer
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_resume_analyzer

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=False
API_TITLE=AI Resume Analyzer API
API_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=app/uploads
ALLOWED_EXTENSIONS=pdf,docx

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ML Model
SPACY_MODEL=en_core_web_sm
SIMILARITY_THRESHOLD=0.6
