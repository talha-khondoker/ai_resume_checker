# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_resume_analyzer
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_resume_analyzer

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_FOLDER=app/uploads
ALLOWED_EXTENSIONS=pdf,docx

# Email (optional for password reset)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# API
API_TITLE=AI Resume Analyzer API
API_VERSION=1.0.0
API_DESCRIPTION=Analyze and match resumes with job descriptions using AI/ML

# ML Model
SPACY_MODEL=en_core_web_sm
SIMILARITY_THRESHOLD=0.6
