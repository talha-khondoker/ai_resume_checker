# ============================================
# AI RESUME ANALYZER - PRODUCTION CONFIG
# ============================================
# IMPORTANT: Change all values below to your production settings
# NEVER commit this file to version control
# ============================================

# Database Configuration (Use Cloud Database)
# Example for AWS RDS, Azure Database, or Heroku PostgreSQL
DB_USER=production_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS_MIN
DB_HOST=your-database-host.aws.amazonaws.com
DB_PORT=5432
DB_NAME=ai_resume_analyzer_prod
DATABASE_URL=postgresql://production_user:CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS_MIN@your-database-host.aws.amazonaws.com:5432/ai_resume_analyzer_prod

# JWT Configuration
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=False
API_TITLE=AI Resume Analyzer API
API_VERSION=1.0.0

# CORS - Update with your production domain
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=app/uploads
ALLOWED_EXTENSIONS=pdf,docx

# Frontend API URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Email Configuration (Optional - for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ML Model
SPACY_MODEL=en_core_web_sm
SIMILARITY_THRESHOLD=0.6

# Security
HTTPS=true
SECURE_COOKIE=true
SAME_SITE_COOKIE=Lax

# Storage
# For cloud storage, use S3-compatible URLs
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
