              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume_id\": 1,\n  \"job_description\": \"We are looking for a Senior Python Developer with expertise in FastAPI, PostgreSQL, and cloud technologies.\",\n  \"analyze_type\": \"full\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/resume/analyze",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "resume", "analyze"]
            }
          }
        },
        {
