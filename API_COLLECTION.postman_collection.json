          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume_id\": 1,\n  \"job_description\": \"Senior Backend Engineer - We are hiring an experienced backend engineer with strong Python skills and experience with FastAPI, PostgreSQL, Docker, and Kubernetes. You should have 5+ years of experience in backend development.\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/resume/job-match",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "resume", "job-match"]
            }
          }
        }
      ]
    },
